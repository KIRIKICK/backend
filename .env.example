# Java .properties syntax. Copy to backend/.env for local/dev only; never commit real values.
# Production must receive secrets through deployment configuration, not this file.

# Database (dev profile; do not use a real host or credential in this example)
DB_URL=jdbc:postgresql://db.example.invalid:5432/kirikick_dev?sslmode=require
DB_USERNAME=app_user
DB_PASSWORD=replace-me
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

# Redis TCP connection. This is not an Upstash REST URL or REST token.
REDIS_HOST=redis.example.invalid
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace-me
# Base namespace only. The application appends :auth and :spring:session.
# Remove legacy AUTH_REDIS_NAMESPACE and AUTH_REDISNAMESPACE when switching to this input.
REDIS_NAMESPACE=kirikick:dev

# Browser/API topology. Must be an origin without a path, query, or credentials.
AUTH_FE_ORIGIN=https://app.example.invalid

# DEV-only opt-in for Vercel/Cloud Run cross-site browser validation.
# Requires Secure cookies; local/prod profiles reject true. Browser third-party-cookie policies can still block cookies.
AUTH_CROSS_SITE_COOKIES=false

# JWT signing and verification keys. Use mounted files or file: locations in deployment.
AUTH_JWT_ISSUER=https://api.example.invalid
AUTH_JWT_AUDIENCE=kirikick
AUTH_JWT_PRIVATE_KEY_LOCATION=file:./secrets/jwt-private.pem
AUTH_JWT_PUBLIC_KEY_LOCATION=file:./secrets/jwt-public.pem

# Kakao OAuth confidential client
KAKAO_CLIENT_ID=replace-me
KAKAO_CLIENT_SECRET=replace-me
KAKAO_REDIRECT_URI=https://api.example.invalid/login/oauth2/code/kakao
